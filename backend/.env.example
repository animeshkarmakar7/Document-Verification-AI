# Application Settings
APP_NAME="Legal Document Intelligence"
APP_VERSION="0.1.0"
DEBUG=True
ENVIRONMENT=development

# Database Settings
DATABASE_URL=postgresql://user:password@localhost:5432/legaldocai

# Redis / Celery
QUEUE_BACKEND=memory
DEDUP_CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
INGESTION_QUEUE_NAME=document.ingestion
CPU_INGESTION_QUEUE_NAME=document.ingestion.cpu
GPU_INGESTION_QUEUE_NAME=document.ingestion.gpu

# Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=legal_admin
STORAGE_SECRET_KEY=change-this-password
STORAGE_BUCKET=legal-documents
STORAGE_REGION=us-east-1
PRESIGNED_UPLOAD_EXPIRY_SECONDS=900
MAX_UPLOAD_SIZE_MB=50

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CLASSIFICATION_BATCH_SIZE=100

# Retrieval
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
VECTOR_STORE_DIRECTORY=.chroma_db
PDF_TEXT_PAGE_BATCH_SIZE=25
SCANNED_PDF_OCR_PAGE_BATCH_SIZE=5
